# CMake configuration file for folly
#
# This provides the Folly::folly target, which you can depend on by adding it
# to your target_link_libraries().
#
# It also defines the following variables, although using these directly is not
# necessary if you use the Folly::folly target instead.
#  FOLLY_INCLUDE_DIR
#  FOLLY_LIBRARIES

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set_and_check(FOLLY_INCLUDE_DIRS "@PACKAGE_INCLUDE_INSTALL_DIR@")
set_and_check(FOLLY_INCLUDE_DIR "@PACKAGE_INCLUDE_INSTALL_DIR@")
set_and_check(FOLLY_CMAKE_DIR "@PACKAGE_CMAKE_INSTALL_DIR@")
set_and_check(
  FOLLY_DEPENDENCY_PROVIDER_MODULE
  "${FOLLY_CMAKE_DIR}/MetaDependencyProvider.cmake")

# find_dependency() ends up changing PACKAGE_PREFIX_DIR, so save
# folly's prefix directory in the FOLLY_PREFIX_DIR variable
set(FOLLY_PREFIX_DIR "${PACKAGE_PREFIX_DIR}")
set(FOLLY_HAVE_RUST_BINDINGS "@FOLLY_HAVE_RUST_BINDINGS@")
set(FOLLY_RUST_TOOLCHAIN "@FOLLY_RUST_TOOLCHAIN@")
if(FOLLY_HAVE_RUST_BINDINGS)
  set_and_check(
    FOLLY_RUST_WORKSPACE_DIR
    "${FOLLY_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/folly/rust")
endif()

# Folly's exported interface carries Jemalloc::jemalloc when allocator support
# was enabled. Recreate that imported target before loading folly-targets.cmake.
if(@FOLLY_HAVE_JEMALLOC_PACKAGE@ AND NOT TARGET Jemalloc::jemalloc)
  set(_folly_saved_cmake_module_path "${CMAKE_MODULE_PATH}")
  set(CMAKE_MODULE_PATH "${FOLLY_CMAKE_DIR}" ${CMAKE_MODULE_PATH})
  find_dependency(Jemalloc MODULE)
  set(CMAKE_MODULE_PATH "${_folly_saved_cmake_module_path}")
  unset(_folly_saved_cmake_module_path)
endif()

# Find glog before loading targets, since targets reference the glog::glog target
if(NOT TARGET glog::glog)
  find_package(Glog QUIET)
endif()

# folly_test_support is exported only when Folly is configured with tests or
# benchmarks. Recreate the GTest targets in its public link interface before
# loading folly-targets.cmake.
if(@FOLLY_HAVE_TEST_SUPPORT_PACKAGE@ AND NOT TARGET GTest::gmock)
  find_dependency(GTest)
endif()

# Include the folly-targets.cmake file, which is generated from our CMake rules
if (NOT TARGET Folly::folly)
  include("${FOLLY_CMAKE_DIR}/folly-targets.cmake")
endif()

# Imported targets are treated as system dependencies by default. On macOS,
# that can put a Homebrew umbrella include directory ahead of the selected
# Folly prefix and silently combine Homebrew headers with /usr/local binaries.
# Keep every exported Folly target in the normal include search tier so the
# provider selected by find_package(folly) wins before unrelated system
# dependency prefixes.
get_property(_folly_imported_targets DIRECTORY PROPERTY IMPORTED_TARGETS)
foreach(_folly_imported_target IN LISTS _folly_imported_targets)
  if(_folly_imported_target MATCHES "^Folly::")
    set_property(
      TARGET "${_folly_imported_target}"
      PROPERTY IMPORTED_NO_SYSTEM TRUE
    )
    set_property(
      TARGET "${_folly_imported_target}"
      PROPERTY SYSTEM FALSE
    )
  endif()
endforeach()
unset(_folly_imported_target)
unset(_folly_imported_targets)

include("${FOLLY_DEPENDENCY_PROVIDER_MODULE}")
if(TARGET Jemalloc::jemalloc)
  meta_validate_dependency_provider(
    PACKAGE Folly
    ANCHOR_TARGET Folly::folly
    TARGETS Jemalloc::jemalloc Folly::folly
  )
else()
  meta_validate_dependency_provider(
    PACKAGE Folly
    ANCHOR_TARGET Folly::folly
    TARGETS Folly::folly
  )
endif()

# Set FOLLY_LIBRARIES from our Folly::folly target
set(FOLLY_LIBRARIES Folly::folly)

# Find folly's dependencies
find_dependency(fmt)
if(@FOLLY_HAVE_BLAKE3@)
  find_dependency(blake3 CONFIG)
endif()

set(Boost_USE_STATIC_LIBS "@FOLLY_BOOST_LINK_STATIC@")
find_package(Boost 1.69.0 REQUIRED
  COMPONENTS
    context
    filesystem
    program_options
    regex
    thread
)

# Some Boost binary packages expose Regex's ICU dependencies as bare library
# names. Replace those with CMake's imported ICU targets so downstream links
# do not depend on an ambient LIBRARY_PATH.
get_target_property(
  _folly_boost_regex_links Boost::regex INTERFACE_LINK_LIBRARIES)
list(FIND _folly_boost_regex_links "icudata" _folly_icu_index)
if(NOT _folly_icu_index EQUAL -1)
  find_dependency(ICU COMPONENTS data i18n uc)
  set(_folly_boost_regex_links_normalized)
  foreach(_folly_link IN LISTS _folly_boost_regex_links)
    if(_folly_link STREQUAL "icudata")
      list(APPEND _folly_boost_regex_links_normalized ICU::data)
    elseif(_folly_link STREQUAL "icui18n")
      list(APPEND _folly_boost_regex_links_normalized ICU::i18n)
    elseif(_folly_link STREQUAL "icuuc")
      list(APPEND _folly_boost_regex_links_normalized ICU::uc)
    else()
      list(APPEND _folly_boost_regex_links_normalized "${_folly_link}")
    endif()
  endforeach()
  set_property(TARGET Boost::regex PROPERTY INTERFACE_LINK_LIBRARIES
    "${_folly_boost_regex_links_normalized}")
endif()

if (NOT folly_FIND_QUIETLY)
  message(STATUS "Found folly: ${FOLLY_PREFIX_DIR}")
endif()
